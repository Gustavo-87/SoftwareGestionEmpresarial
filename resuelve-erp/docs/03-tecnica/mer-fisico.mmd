    pqr_replies {
        integer id PK
        integer pqr_id FK
        integer user_id FK
        text body
        integer is_draft
        text attachments
        datetime sent_at
        datetime created_at
        datetime updated_at
        integer official_response_slot "calculada"
        datetime deleted_at
        datetime anulada_at
        integer anulada_por_user_id
        varchar motivo_anulacion
    }

    %% Unicidad conjunta en pqr_internal_comments(pqr_id, id).
    pqr_internal_comments {
        integer id PK
        integer pqr_id FK
        integer user_id FK
        text body
        datetime created_at
        datetime updated_at
    }

    pqr_communication_operations {
        integer id PK
        integer pqr_id FK
        integer actor_id FK
        char(36) actor_uuid
        varchar(50) operation
        char(36) idempotency_key UK
        char(64) payload_sha256
        varchar(40) result_code
        varchar(20) status
        varchar(20) cleanup_status
        text cleanup_manifest
        varchar(20) notification_status
        integer pqr_reply_id FK
        integer pqr_internal_comment_id FK
        datetime completed_at
        datetime created_at
        datetime updated_at
    }

    %% Unicidad conjunta en pqr_tags(copropiedad_id, name).
    %% Unicidad conjunta en pqr_tags(id, organizacion_id, copropiedad_id).
    pqr_tags {
        integer id PK
        varchar name
        varchar color
        datetime created_at
        datetime updated_at
        integer organizacion_id FK
        integer copropiedad_id FK
        tinyint(1) activo
    }

    pqr_pqr_tag {
        integer pqr_id PK, FK
        integer pqr_tag_id PK, FK
        integer organizacion_id FK
        integer copropiedad_id FK
    }

    satisfaction_surveys {
        integer id PK
        integer pqr_id FK, UK
        integer user_id FK
        integer rating
        text comment
        datetime created_at
        datetime updated_at
    }

    response_templates {
        integer id PK
        varchar name
        varchar subject
        text body
        integer created_by FK
        datetime created_at
        datetime updated_at
    }

    automation_rules {
        integer id PK
        varchar name
        integer tipo_pqr_id FK
        integer assign_to_id FK
        varchar set_status
        tinyint(1) active
        datetime created_at
        datetime updated_at
    }

    %% pqr_tags(copropiedad_id, organizacion_id) → copropiedades(id, organizacion_id).
    copropiedades ||..o{ pqr_tags : "copropiedad_id, organizacion_id"
    %% pqrs(copropiedad_id, organizacion_id) → copropiedades(id, organizacion_id).
    copropiedades ||..o{ pqrs : "copropiedad_id, organizacion_id"
    organizaciones ||..o{ pqr_tags : "organizacion_id"
    organizaciones ||..o{ pqrs : "organizacion_id"
    %% pqr_communication_operations(pqr_id, pqr_internal_comment_id) → pqr_internal_comments(pqr_id, id).
    pqr_internal_comments |o..o{ pqr_communication_operations : "pqr_id, pqr_internal_comment_id"
    %% pqr_communication_operations(pqr_id, pqr_reply_id) → pqr_replies(pqr_id, id).
    pqr_replies |o..o{ pqr_communication_operations : "pqr_id, pqr_reply_id"
    pqr_tags ||--o{ pqr_pqr_tag : "pqr_tag_id"
    %% pqr_pqr_tag(pqr_tag_id, organizacion_id, copropiedad_id) → pqr_tags(id, organizacion_id, copropiedad_id).
    pqr_tags ||..o{ pqr_pqr_tag : "pqr_tag_id, organizacion_id, copropiedad_id"
    pqrs ||--o{ pqr_pqr_tag : "pqr_id"
    pqrs ||..o{ pqr_activities : "pqr_id"
    pqrs ||..o{ pqr_attachments : "pqr_id"
    pqrs ||..o{ pqr_communication_operations : "pqr_id"
    pqrs ||..o{ pqr_internal_comments : "pqr_id"
    %% pqr_pqr_tag(pqr_id, organizacion_id, copropiedad_id) → pqrs(id, organizacion_id, copropiedad_id).
    pqrs ||..o{ pqr_pqr_tag : "pqr_id, organizacion_id, copropiedad_id"
    pqrs ||..o{ pqr_replies : "pqr_id"
    pqrs ||..o| satisfaction_surveys : "pqr_id"
    tipo_pqrs |o..o{ automation_rules : "tipo_pqr_id"
    tipo_pqrs ||..o{ pqrs : "tipo_pqr_id"
    users |o..o{ automation_rules : "assign_to_id"
    users |o..o{ pqr_activities : "user_id"
    users |o..o{ pqr_communication_operations : "actor_id"
    users |o..o{ pqr_internal_comments : "user_id"
    users |o..o{ pqr_replies : "user_id"
    users |o..o{ pqrs : "assigned_to_id"
    users |o..o{ response_templates : "created_by"
    users ||..o{ pqrs : "user_id"
    users ||..o{ satisfaction_surveys : "user_id"

