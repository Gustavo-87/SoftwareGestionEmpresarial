    pqr_activities {
        integer id PK
        integer pqr_id FK
        integer user_id FK
        varchar action
        varchar description
        text metadata
        datetime created_at
        datetime updated_at
    }

    %% Unicidad conjunta en pqr_replies(pqr_id, id).
