    %% documentos(copropiedad_id, organizacion_id) → copropiedades(id, organizacion_id).
    copropiedades |o..o{ documentos : "copropiedad_id, organizacion_id"
    %% mantenimientos(copropiedad_id, organizacion_id) → copropiedades(id, organizacion_id).
    copropiedades ||..o{ mantenimientos : "copropiedad_id, organizacion_id"
    %% documento_actuaciones(documento_version_id, documento_id, organizacion_id, copropiedad_id) → documento_versiones(id, documento_id, organizacion_id, copropiedad_id).
    documento_versiones |o..o{ documento_actuaciones : "documento_version_id, documento_id, organizacion_id, copropiedad_id"
    %% documento_versiones(sustituye_version_id, documento_id, organizacion_id, copropiedad_id) → documento_versiones(id, documento_id, organizacion_id, copropiedad_id).
    documento_versiones |o..o| documento_versiones : "sustituye_version_id, documento_id, organizacion_id, copropiedad_id"
    documento_versiones ||..o{ mantenimiento_documento_evidencia : "documento_version_id"
    %% documento_actuaciones(documento_id, organizacion_id, copropiedad_id) → documentos(id, organizacion_id, copropiedad_id).
    documentos ||..o{ documento_actuaciones : "documento_id, organizacion_id, copropiedad_id"
    %% documento_versiones(documento_id, organizacion_id, copropiedad_id) → documentos(id, organizacion_id, copropiedad_id).
    documentos ||..o{ documento_versiones : "documento_id, organizacion_id, copropiedad_id"
    documentos ||..o{ mantenimiento_documento_evidencia : "documento_id"
    mantenimientos ||..o{ mantenimiento_documento_evidencia : "mantenimiento_id"
    organizaciones ||..o{ documentos : "organizacion_id"
    organizaciones ||..o{ mantenimientos : "organizacion_id"
    pqrs |o..o{ mantenimientos : "pqr_id"
    users |o..o{ documento_actuaciones : "actor_user_id"
    users |o..o{ documento_versiones : "aprobada_por_user_id"
    users |o..o{ documento_versiones : "cargada_por_user_id"
    users |o..o{ documento_versiones : "rechazada_por_user_id"
    users |o..o{ documento_versiones : "sometida_por_user_id"
    users |o..o{ documentos : "archivado_por_user_id"
    users |o..o{ documentos : "creado_por_user_id"
    users |o..o{ mantenimiento_documento_evidencia : "vinculado_por_user_id"
    users |o..o{ mantenimientos : "responsable_id"
    users |o..o{ mantenimientos : "resultado_registrado_por_user_id"
    users ||..o{ documentos : "propietario_documental_user_id"
    users ||..o{ mantenimientos : "solicitante_id"

