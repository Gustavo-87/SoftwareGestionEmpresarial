erDiagram
    %% Resuelve ERP. Esquema físico obtenido al ejecutar las migraciones en SQLite.
    %% Cada línea representa una clave foránea. Su etiqueta identifica las columnas de la tabla hija.
    %% PK = clave primaria, FK = clave foránea, UK = columna con unicidad individual.
    %% Las restricciones únicas compuestas se anotan junto a cada entidad.

    %% Organización y comunidad
    organizaciones {
        integer id PK
        varchar nombre
        varchar identificacion_tributaria UK
        varchar email
        varchar telefono
        varchar estado
        datetime desactivada_at
        datetime created_at
        datetime updated_at
    }

    %% Unicidad conjunta en copropiedades(id, organizacion_id).
    %% Unicidad conjunta en copropiedades(organizacion_id, nit).
    copropiedades {
        integer id PK
        integer organizacion_id FK
        varchar nombre
        varchar nit
        varchar representante_legal
        varchar direccion
        varchar ciudad
        varchar telefono
        varchar email
        varchar estado
        datetime desactivada_at
        datetime created_at
        datetime updated_at
    }

    configuraciones_organizacion {
        integer id PK
        integer organizacion_id FK, UK
        datetime created_at
        datetime updated_at
    }

    %% Unicidad conjunta en configuraciones_copropiedad(copropiedad_id, organizacion_id).
    configuraciones_copropiedad {
        integer id PK
        integer organizacion_id FK
        integer copropiedad_id FK, UK
        varchar color_principal
        varchar logo_path
        integer dias_respuesta
        datetime created_at
        datetime updated_at
    }

    site_settings {
        integer id PK
        varchar nombre_conjunto
        varchar nit
        varchar representante_legal
        varchar direccion
        varchar ciudad
        varchar telefono
        varchar email
        varchar color_principal
        integer dias_respuesta
        datetime created_at
        datetime updated_at
        varchar logo_path
        integer organizacion_id FK
        integer copropiedad_id FK
        numeric logo_scale
        integer logo_offset_x
        integer logo_offset_y
    }

    users {
        integer id PK
        varchar name
        varchar email UK
        datetime email_verified_at
        varchar password
        varchar remember_token
        datetime created_at
        datetime updated_at
        varchar role
        varchar tower
        varchar unit
        tinyint(1) es_administrador_sistema
        varchar estado
        datetime desactivado_at
    }

    %% Unicidad conjunta en personas(id, organizacion_id).
    %% Unicidad conjunta en personas(organizacion_id, identificacion).
    personas {
        integer id PK
        integer organizacion_id FK
        integer usuario_id FK
        varchar tipo_persona
        varchar nombre_razon_social
        varchar identificacion
        varchar email
        varchar telefono
        varchar estado
        datetime desactivada_at
        datetime created_at
        datetime updated_at
    }

    %% Unicidad conjunta en unidades_privadas(copropiedad_id, codigo).
    %% Unicidad conjunta en unidades_privadas(id, organizacion_id, copropiedad_id).
    unidades_privadas {
        integer id PK
        integer organizacion_id FK
        integer copropiedad_id FK
        varchar codigo
        varchar numero_nombre
        varchar torre_bloque
        varchar tipo
        varchar estado
        datetime desactivada_at
        datetime created_at
        datetime updated_at
    }

    %% Unicidad conjunta en vinculos_unidad(persona_id, unidad_privada_id, tipo_vinculo, vigente_desde).
    vinculos_unidad {
        integer id PK
        integer organizacion_id FK
        integer copropiedad_id FK
        integer persona_id FK
        integer unidad_privada_id FK
        varchar tipo_vinculo
        varchar estado
        date vigente_desde
        date vigente_hasta
        varchar fuente
        text observacion
        datetime created_at
        datetime updated_at
    }

    %% site_settings(copropiedad_id, organizacion_id) → copropiedades(id, organizacion_id).
    copropiedades |o..o{ site_settings : "copropiedad_id, organizacion_id"
    %% unidades_privadas(copropiedad_id, organizacion_id) → copropiedades(id, organizacion_id).
    copropiedades ||..o{ unidades_privadas : "copropiedad_id, organizacion_id"
    %% configuraciones_copropiedad(copropiedad_id, organizacion_id) → copropiedades(id, organizacion_id).
    copropiedades ||..o| configuraciones_copropiedad : "copropiedad_id, organizacion_id"
    organizaciones |o..o{ site_settings : "organizacion_id"
    organizaciones ||..o{ copropiedades : "organizacion_id"
    organizaciones ||..o{ personas : "organizacion_id"
    organizaciones ||..o| configuraciones_organizacion : "organizacion_id"
    %% vinculos_unidad(persona_id, organizacion_id) → personas(id, organizacion_id).
    personas ||..o{ vinculos_unidad : "persona_id, organizacion_id"
    %% vinculos_unidad(unidad_privada_id, organizacion_id, copropiedad_id) → unidades_privadas(id, organizacion_id, copropiedad_id).
    unidades_privadas ||..o{ vinculos_unidad : "unidad_privada_id, organizacion_id, copropiedad_id"
    users |o..o{ personas : "usuario_id"

    %% Membresías y autorización contextual
    %% Unicidad conjunta en membresias_organizacion(id, organizacion_id).
    %% Unicidad conjunta en membresias_organizacion(usuario_id, organizacion_id).
    membresias_organizacion {
        integer id PK
        integer usuario_id FK
        integer organizacion_id FK
        varchar estado
        datetime vigente_desde
        datetime vigente_hasta
        integer creada_por FK
        text motivo_terminacion
        datetime created_at
        datetime updated_at
    }

    %% Unicidad conjunta en membresias_copropiedad(id, organizacion_id, copropiedad_id).
    %% Unicidad conjunta en membresias_copropiedad(usuario_id, copropiedad_id).
    membresias_copropiedad {
        integer id PK
        integer usuario_id FK
        integer organizacion_id FK
        integer copropiedad_id FK
        varchar estado
        datetime vigente_desde
        datetime vigente_hasta
        integer creada_por FK
        text motivo_terminacion
        datetime created_at
        datetime updated_at
        integer rol_activo_id FK
    }

    %% Unicidad conjunta en roles(copropiedad_id, name, guard_name).
    roles {
        integer id PK
        integer copropiedad_id
        varchar name
        varchar guard_name
        datetime created_at
        datetime updated_at
    }

    %% Unicidad conjunta en permissions(name, guard_name).
    permissions {
        integer id PK
        varchar name
        varchar guard_name
        datetime created_at
        datetime updated_at
        varchar nombre
        varchar modulo
        text descripcion
        varchar estado
    }

    role_has_permissions {
        integer permission_id PK, FK
        integer role_id PK, FK
    }

    model_has_roles {
        integer role_id PK, FK
        varchar model_type PK
        integer model_id PK
        integer copropiedad_id PK
    }

    model_has_permissions {
        integer permission_id PK, FK
        varchar model_type PK
        integer model_id PK
        integer copropiedad_id PK
    }

    %% Unicidad conjunta en roles_contextuales(id, ambito_aplicable).
    roles_contextuales {
        integer id PK
        varchar clave UK
        varchar nombre
        text descripcion
        varchar ambito_aplicable
        varchar estado
        datetime created_at
        datetime updated_at
    }

    %% Unicidad conjunta en permisos_contextuales(id, ambito_aplicable).
    permisos_contextuales {
        integer id PK
        varchar clave UK
        varchar modulo
        varchar accion
        text descripcion
        varchar ambito_aplicable
        varchar estado
        datetime created_at
        datetime updated_at
    }

    rol_permiso_contextual {
        integer rol_id PK, FK
        integer permiso_id PK, FK
        varchar ambito_aplicable FK
    }

    membresia_organizacion_rol {
        integer id PK
        integer membresia_organizacion_id FK
        integer rol_id FK
        integer organizacion_id FK
        varchar ambito_rol FK
        varchar estado
        datetime vigente_desde
        datetime vigente_hasta
        integer asignado_por FK
        datetime created_at
        datetime updated_at
    }

    membresia_copropiedad_rol {
        integer id PK
        integer membresia_copropiedad_id FK
        integer rol_id FK
        integer organizacion_id FK
        integer copropiedad_id FK
        varchar ambito_rol FK
        varchar estado
        datetime vigente_desde
        datetime vigente_hasta
        integer asignado_por FK
        datetime created_at
        datetime updated_at
    }

    %% membresias_copropiedad(copropiedad_id, organizacion_id) → copropiedades(id, organizacion_id).
    copropiedades ||..o{ membresias_copropiedad : "copropiedad_id, organizacion_id"
    %% membresia_copropiedad_rol(membresia_copropiedad_id, organizacion_id, copropiedad_id) → membresias_copropiedad(id, organizacion_id, copropiedad_id).
    membresias_copropiedad ||..o{ membresia_copropiedad_rol : "membresia_copropiedad_id, organizacion_id, copropiedad_id"
    %% membresia_organizacion_rol(membresia_organizacion_id, organizacion_id) → membresias_organizacion(id, organizacion_id).
    membresias_organizacion ||..o{ membresia_organizacion_rol : "membresia_organizacion_id, organizacion_id"
    organizaciones ||..o{ membresias_organizacion : "organizacion_id"
    %% rol_permiso_contextual(permiso_id, ambito_aplicable) → permisos_contextuales(id, ambito_aplicable).
    permisos_contextuales ||..o{ rol_permiso_contextual : "permiso_id, ambito_aplicable"
    permissions ||--o{ model_has_permissions : "permission_id"
    permissions ||--o{ role_has_permissions : "permission_id"
    roles |o..o{ membresias_copropiedad : "rol_activo_id"
    roles ||--o{ model_has_roles : "role_id"
    roles ||--o{ role_has_permissions : "role_id"
    %% membresia_copropiedad_rol(rol_id, ambito_rol) → roles_contextuales(id, ambito_aplicable).
    roles_contextuales ||..o{ membresia_copropiedad_rol : "rol_id, ambito_rol"
    %% membresia_organizacion_rol(rol_id, ambito_rol) → roles_contextuales(id, ambito_aplicable).
    roles_contextuales ||..o{ membresia_organizacion_rol : "rol_id, ambito_rol"
    %% rol_permiso_contextual(rol_id, ambito_aplicable) → roles_contextuales(id, ambito_aplicable).
    roles_contextuales ||..o{ rol_permiso_contextual : "rol_id, ambito_aplicable"
    users |o..o{ membresia_copropiedad_rol : "asignado_por"
    users |o..o{ membresia_organizacion_rol : "asignado_por"
    users |o..o{ membresias_copropiedad : "creada_por"
    users |o..o{ membresias_organizacion : "creada_por"
    users ||..o{ membresias_copropiedad : "usuario_id"
    users ||..o{ membresias_organizacion : "usuario_id"

    %% Radicación y seguimiento de PQRS
    tipo_pqrs {
        integer id PK
        varchar nombre
        text descripcion
        datetime created_at
        datetime updated_at
        datetime desactivada_at
    }

    %% Unicidad conjunta en pqrs(id, organizacion_id, copropiedad_id).
    pqrs {
        integer id PK
        varchar asunto
        text descripcion
        date fecha_radicacion
        date fecha_limite_respuesta
        varchar estado
        integer user_id FK
        integer tipo_pqr_id FK
        datetime created_at
        datetime updated_at
        integer assigned_to_id FK
        datetime last_reminder_at
        integer organizacion_id FK
        integer copropiedad_id FK
        varchar prioridad
    }

    pqr_attachments {
        integer id PK
        integer pqr_id FK
        varchar original_name
        varchar path
        varchar mime_type
        integer size
